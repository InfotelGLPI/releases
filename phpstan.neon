includes:
    - ../../vendor/glpi-project/phpstan-glpi/extension.neon
    - phpstan-baseline.neon

parameters:
    level: 5
    paths:
        - ajax
        - front
        - src
        - hook.php
        - setup.php
    scanDirectories:
        - ../../inc
        - ../../src
    bootstrapFiles:
        - ../../stubs/glpi_constants.php
        - ../../vendor/autoload.php
        - setup.php
    treatPhpDocTypesAsCertain: false
    # The CI runner analyzes a pristine GLPI 11.0.x core while the local tree may
    # carry core modifications, so PHPStan's type narrowing (and baseline hit counts)
    # can differ between the two. Tolerate baseline entries that do not reproduce on
    # the runner instead of failing on the drift.
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        # CI-only drift: on the pristine runner core, getItemForItemtype() is typed
        # CommonDBTM|false and PHPStan does not narrow the false away here. The
        # itemtype is whitelisted upstream and a false $parent would already fatal on
        # $parent->getForeignKeyField() above, so showSubForm() is only ever called on
        # a real object. Not a real defect.
        -
            message: '#^Cannot call static method showSubForm\(\) on CommonDBTM\|false\.$#'
            identifier: staticMethod.nonObject
            path: ajax/timeline.php
        # CI-only drift: $this->updates is the core CommonDBTM property typed
        # list<string>; unset()-ing a middle element makes PHPStan see a non-list
        # array. This mirrors GLPI core's own post-update cleanup and is safe.
        -
            message: '#^Property CommonDBTM::\$updates \(list<string>\) does not accept array\{\}\.$#'
            identifier: assign.propertyType
            path: src/Release.php
