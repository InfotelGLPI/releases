{# The dropdown change rewrites the anchor href via change_release_form.js
   (config carried by the [data-releases-linkgroup] wrapper). #}
<div class="mb-3" data-releases-linkgroup data-url="{{ base_url }}" data-target="#{{ anchor_id }}">
    {{ dropdown_html|raw }}
    <br/><br/>
    <a class="submit btn btn-primary" id="{{ anchor_id }}" href="{{ initial_href }}">
        <i class="ti ti-circle-plus"></i>&nbsp;{{ __('Create a release', 'releases') }}
    </a>
</div>
