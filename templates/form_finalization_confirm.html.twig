{% import "components/form/fields_macros.html.twig" as fields %}

{% if not allfinish %}
    <div class="alert alert-important alert-warning d-flex">
        {{ __('Care all steps are not finish !', 'releases') }}
    </div>
{% endif %}

<form name="release_form" id="release_form" method="post" action="{{ action_url }}">
    {{ fields.datetimeField(
        'date_production',
        '',
        __('Production run date', 'releases'),
        {'maybeempty': false}
    ) }}

    <input type="hidden" name="id" value="{{ id }}"/>
    {% if is_failed %}
        <input type="hidden" name="failedtasks" value="{{ failed_tasks }}"/>
        <input type="hidden" name="failedtests" value="{{ failed_tests }}"/>
    {% endif %}

    <div class="d-flex justify-content-center mt-2">
        {% if is_failed %}
            <button type="submit" name="failed" class="btn btn-danger">
                <i class="ti ti-x"></i>&nbsp;{{ __('Mark as failed', 'releases') }}
            </button>
        {% else %}
            <button type="submit" name="finalize" class="btn btn-success">
                <i class="ti ti-check"></i>&nbsp;{{ __('Finalize', 'releases') }}
            </button>
        {% endif %}
    </div>

    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}"/>
</form>
