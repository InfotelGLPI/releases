{% import "components/form/fields_macros.html.twig" as fields %}

{% set bg = "" %}
{% if item.isDeleted() %}
    {% set bg = "asset-deleted" %}
{% endif %}

<div class="asset {{ bg }}">
    {% include("components/form/header.html.twig") %}

    <div class="card-body d-flex">
        <div class="col-12 flex-column">
            <div class="row flex-row">

                {{ fields.hiddenField(
                    'plugin_releases_releasetemplates_id',
                    releasetemplates_id
                ) }}

                {{ fields.textField(
                    'name',
                    item.fields['name'],
                    __('Name')
                ) }}

                {{ fields.dropdownField(
                    'GlpiPlugin\\Releases\\Deploytasktemplate',
                    'plugin_releases_deploytasktemplates_id',
                    item.fields['plugin_releases_deploytasktemplates_id'],
                    __('Previous task', 'releases'),
                    {
                        'condition': previous_condition,
                        'comments': false,
                    }
                ) }}

                {{ fields.dropdownField(
                    'GlpiPlugin\\Releases\\TypeDeployTask',
                    'plugin_releases_typedeploytasks_id',
                    item.fields['plugin_releases_typedeploytasks_id'],
                    __('Deploy Task type', 'releases')
                ) }}

                {{ fields.dropdownField(
                    'GlpiPlugin\\Releases\\Risktemplate',
                    'plugin_releases_risks_id',
                    item.fields['plugin_releases_risks_id'],
                    __('Risk', 'releases'),
                    {
                        'condition': risk_condition,
                    }
                ) }}

                {% if has_state %}
                    {{ fields.dropdownArrayField(
                        'state',
                        item.fields['state'],
                        state_values,
                        __('Status')
                    ) }}
                {% endif %}

                {% if item.maybePrivate() %}
                    {{ fields.dropdownYesNo(
                        'is_private',
                        item.fields['is_private'],
                        __('Private')
                    ) }}
                {% endif %}

                {{ fields.dropdownTimestampField(
                    'actiontime',
                    item.fields['actiontime'],
                    __('Duration'),
                    {
                        'min': 0,
                        'max': actiontime_max,
                        'addfirstminutes': true,
                        'inhours': true,
                        'toadd': actiontime_toadd,
                    }
                ) }}

                {{ fields.dropdownField(
                    'User',
                    'users_id_tech',
                    users_id_tech,
                    __('By'),
                    {
                        'right': 'own_ticket',
                        'entity': item.fields['entities_id'],
                    }
                ) }}

                {{ fields.dropdownField(
                    'Group',
                    'groups_id_tech',
                    item.fields['groups_id_tech'],
                    __('Group'),
                    {
                        'condition': {'is_task': 1},
                        'entity': item.fields['entities_id'],
                    }
                ) }}

                {% if not item.isNewItem() %}
                    {{ fields.datetimeField(
                        'date',
                        item.fields['date'],
                        __('Date'),
                        {
                            'maybeempty': false,
                        }
                    ) }}
                {% endif %}

                {{ fields.textareaField(
                    'content',
                    item.fields['content'],
                    __('Content'),
                    {
                        'full_width': true,
                        'enable_richtext': true,
                        'enable_fileupload': false,
                        'rows': 10,
                    }
                ) }}
            </div>
        </div>
    </div>

    {% include("components/form/buttons.html.twig") %}
</div>
