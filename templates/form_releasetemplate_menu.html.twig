<div class="d-flex justify-content-center">
    <div class="card mb-3" style="min-width: 22rem;">
        <div class="card-header">
            <h3 class="card-title">
                <i class="ti ti-rocket me-1"></i>{{ __('Release', 'releases') }}
            </h3>
        </div>
        <div class="card-body text-center">
            {# GET form so the selected template id (template_id) is always
               submitted to release.form.php, independent of any client JS. #}
            <form method="get" action="{{ form_action }}">
                {% if has_templates %}
                    <label class="form-label fw-bold">{{ __('Use this template', 'releases') }}</label>
                    {{ dropdown_html|raw }}
                    <div class="my-3"></div>
                {% endif %}
                <button type="submit" class="btn btn-primary">
                    <i class="ti ti-circle-plus"></i>&nbsp;{{ __('Create a release', 'releases') }}
                </button>
            </form>
        </div>
    </div>
</div>
