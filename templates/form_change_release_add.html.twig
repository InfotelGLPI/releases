<div class="firstbloc">
    <form name="change_release_add_form" method="post" action="{{ action_url }}">
        <table class="tab_cadre_fixe">
            <tr class="tab_bg_2">
                <th colspan="3">{{ title }}</th>
            </tr>
            <tr class="tab_bg_2">
                <td>
                    <input type="hidden" name="{{ hidden_name }}" value="{{ hidden_value }}"/>
                    {{ dropdown_html|raw }}
                </td>
                <td class="center">
                    <button type="submit" name="add" class="btn btn-primary">
                        <i class="ti ti-plus"></i>&nbsp;{{ _x('button', 'Add') }}
                    </button>
                </td>
                <td></td>
            </tr>
        </table>
        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}"/>
    </form>
</div>
