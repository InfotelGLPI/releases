<div class="timeline_form">
    <div class="filter_timeline_release">
        <ul class="timeline_choices">
            {% for type in types %}
                <li class="{{ type.li_class }}">
                    <a href="#" data-type="{{ type.data_type }}" title="{{ type.name }}">
                        <i class="ti {{ type.icon }}"></i>&nbsp;{{ type.name }} ({{ type.count }})
                    </a>
                    {% if type.canadd %}
                        <button type="button"
                                class="btn btn-sm btn-ghost-secondary px-1 ms-1"
                                title="{{ _x('button', 'Add') }}"
                                data-releases-add
                                data-itemtype="{{ type.itemtype }}"
                                data-parenttype="{{ parenttype }}"
                                data-fkey="{{ foreign_key }}"
                                data-parentid="{{ parent_id }}"
                                data-target="#{{ ajax_box_id }}"
                                data-url="{{ subitem_url }}">
                            <i class="ti ti-circle-plus"></i>
                            <span class="sr-only">{{ _x('button', 'Add') }}</span>
                        </button>
                    {% endif %}
                </li>
            {% endfor %}
        </ul>
    </div>
    <div class="clear">&nbsp;</div>
</div>

<div class="ajax_box" id="{{ ajax_box_id }}"></div>
