<span class="actor-bloc">
    <div class="actor-head">{{ title }}</div>
    <div class="actor-content">
        {% for row in rows %}
            {% if row.icon is defined and row.icon is not null %}
                <i class="ti {{ row.icon.class }}" title="{{ row.icon.title }}"></i><span class="sr-only">{{ row.icon.title }}</span>
                {% if row.label is defined %}&nbsp;{% endif %}
            {% endif %}
            {% if row.label is defined %}
                {{ row.label }}
            {% endif %}
            {% if row.widget is defined %}
                {# raw: core dropdown output (User/Group/Supplier/Entity::dropdown), escaped by the core #}
                {{ row.widget|raw }}
            {% endif %}
            {% if row.hidden is defined %}
                <input type="hidden" name="{{ row.hidden.name }}" value="{{ row.hidden.value }}">
            {% endif %}
            {% if row.after is defined and row.after == 'hr' %}
                <hr>
            {% elseif row.after is defined and row.after == 'br' %}
                <br>
            {% endif %}
        {% endfor %}
    </div>
</span>
