{% import "components/form/fields_macros.html.twig" as fields %}

{% set bg = "" %}
{% if item.isDeleted() %}
    {% set bg = "asset-deleted" %}
{% endif %}

<div class="asset {{ bg }}">
    {% include("components/form/header.html.twig") %}

    <div class="card-body d-flex">
        <div class="col-12 flex-column">
            <div class="row flex-row">

                {{ fields.hiddenField(
                    'plugin_releases_releasetemplates_id',
                    item.fields['plugin_releases_releasetemplates_id']
                ) }}

                {{ fields.textField(
                    'name',
                    item.fields['name'],
                    __('Name')
                ) }}

                {{ fields.dropdownField(
                    'GlpiPlugin\\Releases\\TypeTest',
                    'plugin_releases_typetests_id',
                    typetests_id,
                    __('Test type', 'releases')
                ) }}

                {{ fields.dropdownField(
                    'GlpiPlugin\\Releases\\Risktemplate',
                    'plugin_releases_risks_id',
                    item.fields['plugin_releases_risks_id'],
                    __('Associated risk', 'releases'),
                    {
                        'condition': {
                            'plugin_releases_releasetemplates_id': item.fields['plugin_releases_releasetemplates_id']
                        }
                    }
                ) }}

                {{ fields.textareaField(
                    'content',
                    item.fields['content'],
                    __('Description'),
                    {
                        'full_width': true,
                        'enable_richtext': true,
                        'enable_fileupload': false,
                        'rows': 10,
                    }
                ) }}
            </div>
        </div>
    </div>

    {% include("components/form/buttons.html.twig") %}
</div>
